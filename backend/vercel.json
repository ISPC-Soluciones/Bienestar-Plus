{
  "version": 2,
  "builds": [
    {
      "src": "bienestar_plus_api/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "15mb", "runtime": "python3.11" }
    },
    {
      "src": "manage.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "bienestar_plus_api/wsgi.py"
    }
  ],
  "env": {
    "DJANGO_SETTINGS_MODULE": "bienestar_plus_api.settings"
  }
}
