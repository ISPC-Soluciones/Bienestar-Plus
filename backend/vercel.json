{
  "version": 2,
  "builds": [
    {
      "src": "backend/bienestar_plus_api/wsgi.py",
      "use": "@vercel/python",
      "config": { "runtime": "python3.11" }
    }
  ],
  "buildCommand": "python backend/manage.py collectstatic --noinput",
  "routes": [
    {
      "src": "/(.*)",
      "dest": "backend/bienestar_plus_api/wsgi.py"
    }
  ]
}
