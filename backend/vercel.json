{
  "version": 2,
  "builds": [
    {
      "src": "wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "15mb",
        "runtime": "python3.11"
      }
    },
    {
      "src": "static_src/**",
      "use": "@vercel/static"
    }
  ],

  "buildCommand": "python copy_rest_framework_static.py && python manage.py collectstatic --clear --noinput",

  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "wsgi.py"
    }
  ],
  "outputDirectory": "staticfiles"
}
